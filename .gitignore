# Operating systems and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Credentials and local overrides
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/

# Pixi and model/download caches
.pixi/
.cache/
tools/

# Experiment and evaluation artifacts
outputs/
grey_shaded_outputs/
metrics/external/
metrics/results/
metrics/**/_metrics/
tasks/*/.cache/
tasks/.runtime-*/
.remote-blender/

# Benchmark assets are distributed separately.
benchmark/*
!benchmark/README.md

# Keep downloads in older checkouts untracked during layout migration.
data/benchmark/
evaluation/external/
evaluation/results/
scripts/*/.cache/

# Optional local dependency staging; dependencies come from pyproject.toml.
core/harness/vendor/
core/harness/input/
core/harness/output/

# Runtime logs and Blender backups
*.log
*.blend1
*.blend2
