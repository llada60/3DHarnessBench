# Copy to the experiment root as .env. See INSTALL.md for the ordered setup.
# All five public Python entry points load it automatically on every launch.
# Existing exported shell variables take precedence. This file is parsed as
# dotenv data: quotes and ${NAME} expansion work; shell commands do not run.
# Keep unused optional variables commented out. Never commit your .env.

# Blender 5.1.2 executable, not its containing directory. Use an absolute
# path or a tools/... path relative to this checkout. Empty means auto-detect.
BLENDER=""
# Linux: BLENDER="tools/blender-5.1.2-linux-x64/blender"
# macOS: BLENDER="/Applications/Blender.app/Contents/MacOS/Blender"

# Kimi Code key accepted by https://api.kimi.com/coding.
# The isolated experiment adapter uses this key instead of CLI OAuth state.
# MOONSHOT_API_KEY=""

# Alibaba Cloud Coding Plan key for the configured international endpoint.
# QWEN_API_KEY=""

# MiniMax official API key. No MiniMax CLI is used by this repository.
# MINIMAX_API_KEY=""

# Codex and Claude normally use their own CLI login, completed separately.
# API billing: Codex also needs the --with-api-key login step in INSTALL.md.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# Evaluation: DINOv3 requires an approved Hugging Face account/token.
# HF_TOKEN=""
# Existing HF CLI logins work automatically. For a non-default credential file:
# HF_TOKEN_PATH="/absolute/path/to/token-file"
# If Hugging Face downloads fail with CAS/Xet errors, use HTTP instead.
# HF_HUB_DISABLE_XET="1"
# The default Uni3D checkout is evaluation/external/Uni3D.
# UNI3D_REPO="/absolute/path/to/Uni3D"

# Optional Kimi executable override. Codex, Claude and Qwen must be on PATH.
# KIMI_BIN="/absolute/path/to/kimi"

# Optional Linux GPU selection. Both MCP configs default to gpu_device="auto"
# and inherit this value. Explicit gpu_device settings override it for Blender.
# CUDA_VISIBLE_DEVICES="0"

# Linux ActiveVisual viewport acceleration; default is the first working EGL
# device. Use egl0/egl1 when selecting a particular physical viewport GPU.
# VGL_DEVICE="egl"
